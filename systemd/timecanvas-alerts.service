[Unit]
Description=TimeCanvas alerts: check camera/capture/disk/services and notify (Teams, email)
RequiresMountsFor=/srv/timecanvas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=timecanvas
Group=timecanvas
Environment=PYTHONPATH=/opt/timecanvas/app PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m timecanvas alerts
PrivateDevices=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timecanvas /var/log/timecanvas
RuntimeDirectory=timecanvas
RuntimeDirectoryPreserve=yes
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
TimeoutStartSec=120
