[Unit]
Description=TimeCanvas config + database backup
RequiresMountsFor=/srv/timecanvas

[Service]
Type=oneshot
ExecStart=/opt/timecanvas/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups /var/lib/timecanvas
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
